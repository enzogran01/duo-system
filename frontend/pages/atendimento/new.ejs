<%- include('../includes/head') %>

    <main class="w-full h-full flex flex-col md:flex-row pt-15 md:pt-16">
        <section class="w-full p-6 md:p-16" data-aos="fade-right" data-aos-offset="10" data-aos-delay="10000" data-aos-duration="1000">
            <div class="w-full flex flex-col md:flex-row items-center justify-between md:mb-6">
                <div class="flex flex-col w-full md:w-auto md:flex-row items-start md:items-center gap-2 md:gap-4">
                    <a href="/" class="text-action bg-white rounded-xl p-2 w-fit transition-all hover:-translate-y-0.5">Voltar</a>
                    <h1 class="text-xl text-center font-bold mb-4 md:mb-2 lg:mb-0">Criar novo atendimento</h1>
                </div>
                
                <div class="flex p-2.5 bg-white rounded gap-8 mb-4 md:mb-0">
                    <!-- atendimentos -->
                    <button id="resetInputsBtn" data-tippy-content="Limpar campos" class="cursor-pointer transition-all hover:-translate-y-0.5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-icon lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                    </button>
                </div>
            </div>

            <div class="w-full bg-white rounded p-6">
                <h2 class="font-bold text-xl border-b pb-1 mb-4">Dados do Atendimento</h2>

                <form method="POST" action="/atendimento/new" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-item flex flex-col md:col-span-2">
                        <label for="ficha">Paciente*</label>
                        <select id="ficha" name="ficha" class="create-input p-2 rounded-t border-b transition-all focus:outline-none focus:bg-neutral" required>
                            <option value="" disabled selected>Selecione um paciente...</option>
                            <% if (fichas && fichas.length > 0) { %>
                                <% fichas.forEach(fichaObj => { %>
                                    <option value="<%= fichaObj._id %>"><%= fichaObj.nome %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-item flex flex-col">
                        <label for="data_atendimento">Data do Atendimento*</label>
                        <input type="date" id="data_atendimento" name="data_atendimento" class="create-input p-2 rounded-t border-b transition-all focus:outline-none focus:bg-neutral" required>
                    </div>

                    <div class="form-item flex flex-col">
                        <label for="horario">Horário do Atendimento*</label>
                        <input type="time" id="horario" name="horario" class="create-input p-2 rounded-t border-b transition-all focus:outline-none focus:bg-neutral" required>
                    </div>

                    <div class="form-item flex flex-col">
                        <label for="servico">Serviço*</label>
                        <input type="text" id="servico" name="servico" class="create-input p-2 rounded-t border-b transition-all focus:outline-none focus:bg-neutral" required>
                    </div>

                    <div class="form-item flex flex-col md:col-span-2">
                        <label for="queixa">Queixa</label>
                        <textarea id="queixa" name="queixa" rows="3" class="create-input p-2 rounded-t border-b transition-all focus:outline-none focus:bg-neutral resize-y" ></textarea>
                    </div>

                    <div class="form-item flex flex-col md:col-span-2">
                        <label for="rotina_diaria">Rotina Diária</label>
                        <textarea id="rotina_diaria" name="rotina_diaria" rows="3" class="create-input p-2 rounded-t border-b transition-all focus:outline-none focus:bg-neutral resize-y" ></textarea>
                    </div>

                    <div class="form-item flex flex-col md:col-span-2">
                        <label for="prescricao">Prescrição</label>
                        <textarea id="prescricao" name="prescricao" rows="3" class="create-input p-2 rounded-t border-b transition-all focus:outline-none focus:bg-neutral resize-y" ></textarea>
                    </div>

                    <div class="form-item flex flex-col md:col-span-2">
                        <label for="profissional">Profissional Responsável*</label>
                        <select id="profissional" name="profissional" class="create-input p-2 rounded-t border-b transition-all focus:outline-none focus:bg-neutral" required>
                            <option value="" disabled selected>Selecione um profissional...</option>
                            <option value="Luciana Granata">Luciana Granata</option>
                            <option value="Cleusa Granata">Cleusa Granata</option>
                        </select>
                    </div>

                    <button id="submitEditButton" class="bg-action text-white rounded p-4 cursor-pointer transition-all w-full md:w-fit hover:-translate-y-0.5 disabled:bg-action/60 disabled:cursor-auto disabled:hover:translate-y-0 md:col-span-2 mt-2" type="submit" disabled>Cadastrar Atendimento</button>
                </form>
            </div>
        </section>
    </main>

<%- include('../includes/footer') %>